# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
PLUGIN_DIR="$CONFIG_DIR/plugins"
SECTION_HEIGHT=28
SECTION_PADDING=20

source "$HOME/.config/themes/catpuccin/shellcolors.lua"

BORDER="$ACTIVE"
BACKGROUND=0xdd313244

##### Bar Appearance #####

bar=(
  position=top
  height=38
  margin=0
  y_offset=6
  blur_radius=30
  color=0x33000000
  corner_radius=1
  border_width=0
  border_color=$BORDER
  shadow=on
  padding_left=14
  padding_right=14
)

sketchybar --bar "${bar[@]}"

##### Changing Defaults #####

default=(
  icon.font="JetBrains Mono:Medium:14.0"
  label.font="JetBrains Mono:Medium:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
  background.corner_radius=50
)
sketchybar --default "${default[@]}"
sketchybar --add event aerospace_workspace_change

# arch logo (monochrome)

sketchybar --add item arch_logo left \
           --set arch_logo icon="󰣇" \
                        icon.font="JetBrainsMono Nerd Font:Bold:25.0" \
                        icon.color=0xffffffff \
                        label.drawing=off \
                        padding_left=10 \
                        padding_right=10

##### Adding AeroSpace workspace indicators #####
for sid in {1..9}
do
  sketchybar --add item space."$sid" left \
             --set space."$sid" \
                   label="$sid" \
                   script="$PLUGIN_DIR/aerospace_spaces.sh" \
                   click_script="aerospace workspace $sid" \
                   icon.drawing=off \
                   label.align=center \
                   label.width=36 \
                   label.padding_left=0 \
                   label.padding_right=0 \
                   width=36 \
                   background.height=$SECTION_HEIGHT \
                   background.corner_radius=6 \
                   background.color=0x00000000 \
                   padding_left=0 \
                   padding_right=0 \
             --subscribe space."$sid" aerospace_workspace_change
done

sketchybar --add bracket spaces space.1 space.2 space.3 space.4 space.5 space.6 space.7 space.8 space.9 \
           --set spaces background.height=$SECTION_HEIGHT \
                        background.color=$BACKGROUND \
                        background.border_width=0 \
                        padding_left=0 \
                        padding_right=$SECTION_PADDING

sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                          script="$PLUGIN_DIR/front_app.sh" \
                          background.drawing=off \
                          background.height=$SECTION_HEIGHT \
                          label.align=left \
                          label.padding_left=9 \
                          label.padding_right=12 \
           --subscribe front_app front_app_switched

sketchybar --add item clock right \
           --set clock update_freq=10 \
                 icon.color=$CLOCK \
                 padding_left=10 \
                 background.drawing=off \
                 script="$PLUGIN_DIR/clock.sh" \
                 background.height=$SECTION_HEIGHT \
                 background.color=$BACKGROUND \
                 background.border_width=0 \


sketchybar --add item battery right \
           --set battery update_freq=120 \
                         script="$PLUGIN_DIR/battery.sh" \
                         background.drawing=off \
                         padding_left=10 \
           --subscribe battery system_woke power_source_change \

sketchybar --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" background.drawing=off update_freq=5 \
           --subscribe volume volume_change

sketchybar --add item cpu right \
           --set cpu script="$PLUGIN_DIR/cpu.sh" \
                     update_freq=5 \
                     padding_left=10

sketchybar --add item memory right \
           --set memory script="$PLUGIN_DIR/memory.sh" \
                     update_freq=5 \
                     padding_left=10

sketchybar --add bracket systeminfo battery memory \
           --set systeminfo background.height=$SECTION_HEIGHT \
                            background.color=$BACKGROUND \
                            background.border_width=0 \
                            padding_left=$SECTION_PADDING \
                            padding_right=$SECTION_PADDING

sketchybar --update
